#include <winver.h>

#define RT_MANIFEST 24
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1

IDI_MAIN ICON "app.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "A4PAPER"
            VALUE "FileDescription",  "Project Shattered Star - Mindustry Fangame"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "ShatteredStar"
            VALUE "LegalCopyright",   "Fan work, non-commercial"
            VALUE "OriginalFilename", "ShatteredStar.exe"
            VALUE "ProductName",      "Project Shattered Star"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
